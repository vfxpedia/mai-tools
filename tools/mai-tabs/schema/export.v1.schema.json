{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mai-tabs-export-v1",
  "title": "mai-tabs export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "exported_at",
    "browser",
    "urls_sanitized",
    "counts",
    "windows",
    "groups"
  ],
  "properties": {
    "schema": {
      "const": "mai-tabs-export-v1"
    },
    "exported_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "urls_sanitized": {
      "const": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows",
        "tabs",
        "groups"
      ],
      "properties": {
        "windows": {
          "type": "integer",
          "minimum": 0
        },
        "tabs": {
          "type": "integer",
          "minimum": 0
        },
        "groups": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "focused",
          "tabs"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "focused": {
            "type": "boolean"
          },
          "tabs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "index",
                "title",
                "url",
                "pinned",
                "audible",
                "discarded",
                "group_id",
                "last_accessed_ms"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^[^?#]*$",
                  "description": "Sanitized: never contains a query string or a fragment."
                },
                "pinned": {
                  "type": "boolean"
                },
                "audible": {
                  "type": "boolean"
                },
                "discarded": {
                  "type": "boolean"
                },
                "group_id": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "last_accessed_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "url_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "First 16 hex characters of SHA-256 of the full original address. Same page means same url_id; the address itself is never stored."
                }
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "color",
          "collapsed"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "collapsed": {
            "type": "boolean"
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "scope",
        "notes"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "scope": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
