{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mai-approve-receipt-v1",
  "title": "mai-approve-receipt-v1: record of one run, grants nothing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "experiment_unit_id",
    "attempt_kind",
    "approval_sha256",
    "started_at"
  ],
  "properties": {
    "schema": {
      "enum": ["mai-approve-receipt-v1", "mai-run-receipt-v1"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "experiment_unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "attempt_kind": {
      "enum": [
        "normal",
        "canary_retry"
      ]
    },
    "approval_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ended_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "enum": [
        "started",
        "ended",
        "failed",
        "aborted"
      ]
    }
  }
}
